{
    "name": "phrity/util-interpolator",
    "type": "library",
    "description": "Interpolator class and trait.",
    "homepage": "https://phrity.sirn.se/util-interpolator",
    "keywords": ["interpolator", "interpolate"],
    "license": "MIT",
    "authors": [
        {
            "name": "Sören Jensen",
            "email": "sirn@sirn.se",
